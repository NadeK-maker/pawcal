rules_version = '2';

// Scoopy : chaque compte Google ne peut lire et écrire que son propre document
// users/{uid}. L'app n'écrit jamais "premium" : il est refusé ici pour qu'un
// utilisateur ne puisse pas se l'attribuer en modifiant l'app.
// À coller dans la console Firebase → Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['premium'])
        && request.resource.data.pets is list
        && request.resource.data.pets.size() <= 20;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
